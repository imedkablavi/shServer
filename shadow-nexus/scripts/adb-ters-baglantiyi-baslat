#!/usr/bin/env bash
set -Eeuo pipefail
PORT="${SN_PORT:-34871}"
command -v adb >/dev/null || { echo "HATA: adb komutu bulunamadı." >&2; exit 1; }
SERIAL="$(adb devices | awk 'NR>1 && $2=="device" {print $1; exit}')"
[[ -n "$SERIAL" ]] || { echo "HATA: Yetkilendirilmiş Android cihazı bulunamadı." >&2; exit 1; }
adb -s "$SERIAL" reverse "tcp:$PORT" "tcp:$PORT"
echo "ADB ters bağlantısı hazır: telefonun 127.0.0.1:$PORT adresi bilgisayardaki portala yönlendirildi."
