#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

APP_VERSION="1.1.0"
BASE_MOUNT="/srv/cs2ssd"
CASE_DIR="${CASE_DIR:-/srv/cs2ssd/usb-forensics/case-001}"
EXPECTED_SERIAL="${EXPECTED_SERIAL:-54BIZH6NCUSC1HIE}"
EVIDENCE_ID="${EVIDENCE_ID:-USB-001}"
IMAGE_DIR="$CASE_DIR/images"
HASH_DIR="$CASE_DIR/hashes"
LOG_DIR="$CASE_DIR/logs"
SHOT_DIR="$CASE_DIR/screenshots"
NOTES_DIR="$CASE_DIR/notes"
ANALYSIS_DIR="$CASE_DIR/analysis"
REPORT_DIR="$CASE_DIR/report"
TOOLS_IMAGE="${TOOLS_IMAGE:-usb-forensics-tools:local}"
DEV=""
PART=""
ACTIVE_MOUNT=""
START_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

die() { printf 'FATAL: %s\n' "$*" >&2; exit 1; }
log() { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }

[[ "$(id -u)" -ne 0 ]] || die "Run as an ordinary user; sudo will be used only for operations requiring it."
command -v sudo >/dev/null || die "sudo is required"
command -v docker >/dev/null || die "Docker CLI is required"
command -v lsblk >/dev/null || die "lsblk is required"
command -v sha256sum >/dev/null || die "sha256sum is required"
command -v python3 >/dev/null || die "python3 is required"
command -v flock >/dev/null || die "flock is required"
command -v mountpoint >/dev/null || die "mountpoint is required"
command -v termshot >/dev/null || command -v "$HOME/.local/bin/termshot" >/dev/null || die "termshot is required for screenshots"
TERM_SHOT="$(command -v termshot || printf '%s' "$HOME/.local/bin/termshot")"

for path in "$IMAGE_DIR" "$HASH_DIR" "$LOG_DIR" "$SHOT_DIR" "$NOTES_DIR" "$ANALYSIS_DIR" "$REPORT_DIR"; do
  mkdir -p "$path"
done

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DIR="$CASE_DIR/runs/$RUN_ID"
mkdir -p "$RUN_DIR"
exec 9>"$RUN_DIR/workflow.lock"
flock -n 9 || die "Another workflow appears to be running."
exec > >(tee -a "$RUN_DIR/workflow-console.txt") 2>&1

cleanup_on_exit() {
  local rc=$?
  trap - EXIT
  if [[ -n "${ACTIVE_MOUNT:-}" ]] && mountpoint -q "$ACTIVE_MOUNT"; then
    sudo umount "$ACTIVE_MOUNT" >/dev/null 2>&1 || true
  fi
  if [[ -n "${DEV:-}" && -b "$DEV" ]]; then
    sudo blockdev --setro "$DEV" >/dev/null 2>&1 || true
  fi
  exit "$rc"
}
trap cleanup_on_exit EXIT

capture() {
  local label="$1"; shift
  [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid capture label: $label"
  local stamp log_file png_file rc
  stamp="$(date -u +%Y%m%dT%H%M%S_%N)"
  log_file="$LOG_DIR/${stamp}_${label}.txt"
  png_file="$SHOT_DIR/${stamp}_${label}.png"
  rc=0
  {
    printf 'Step: %s\nUTC: %s\nHost: %s\nCase: %s\nCommand:' "$label" "$(date -u --iso-8601=seconds)" "$(hostname)" "$CASE_DIR"
    printf ' %q' "$@"
    printf '\n\n--- OUTPUT ---\n'
  } > "$log_file"
  if "$@" >> "$log_file" 2>&1; then
    rc=0
  else
    rc=$?
  fi
  {
    printf '\n--- END OF OUTPUT ---\nExit code: %s\nUTC end: %s\n' "$rc" "$(date -u --iso-8601=seconds)"
  } >> "$log_file"
  cat "$log_file"
  if ! "$TERM_SHOT" --raw-read "$log_file" --filename "$png_file" --columns 120; then
    log "WARNING: PNG creation failed for $label. Text log retained."
  fi
  sha256sum "$log_file" > "$HASH_DIR/$(basename "$log_file").sha256"
  [[ "$rc" -eq 0 ]] || die "Step '$label' failed (exit $rc). See $log_file"
}

need_confirmation() {
  local prompt="$1" expected="$2" answer
  printf '\n%s\nType exactly: %s\n> ' "$prompt" "$expected"
  IFS= read -r answer || die "No confirmation received."
  [[ "$answer" == "$expected" ]] || die "Confirmation mismatch; stopped without continuing."
}

discover_device() {
  local path="/dev/disk/by-id/usb-Generic_Flash_Disk_${EXPECTED_SERIAL}-0:0"
  [[ -e "$path" ]] || die "Expected stable USB ID is missing: $path"
  DEV="$(readlink -f "$path")"
  [[ -b "$DEV" ]] || die "Resolved path is not a block device."
  local props serial model type tran
  props="$(sudo udevadm info --query=property --name="$DEV")"
  serial="$(sed -n 's/^ID_SERIAL_SHORT=//p' <<< "$props" | head -n1)"
  model="$(sed -n 's/^ID_MODEL=//p' <<< "$props" | head -n1)"
  type="$(lsblk -dn -o TYPE "$DEV" | tr -d ' ')"
  tran="$(lsblk -dn -o TRAN "$DEV" | tr -d ' ')"
  [[ "$serial" == "$EXPECTED_SERIAL" ]] || die "USB serial mismatch (expected $EXPECTED_SERIAL; got ${serial:-missing})."
  [[ "$type" == disk && "$tran" == usb ]] || die "Expected a whole USB disk."
  [[ "$DEV" != /dev/sda && "$DEV" != /dev/sdb ]] || die "Safety stop: selected path matches a protected server disk."
  [[ "$model" == *Flash* || "$model" == *FLASH* || "$model" == *Disk* ]] || die "Unexpected USB model: ${model:-missing}"
}

check_storage() {
  mountpoint -q "$BASE_MOUNT" || die "$BASE_MOUNT is not mounted."
  local source_case source_mount avail image_bytes required
  source_mount="$(findmnt -n -o SOURCE --target "$BASE_MOUNT")"
  source_case="$(findmnt -n -o SOURCE --target "$CASE_DIR")"
  [[ -n "$source_mount" && "$source_case" == "$source_mount" ]] || die "Case directory must reside on the mounted evidence disk at $BASE_MOUNT."
  avail="$(df -B1 --output=avail "$BASE_MOUNT" | tail -n1 | tr -d ' ')"
  image_bytes="$(sudo blockdev --getsize64 "$DEV")"
  required=$((image_bytes * 4 + image_bytes / 2 + 1073741824))
  (( avail >= required )) || die "Insufficient storage: available=$avail required~=$required bytes."
  printf 'mount_source=%s\navailable_bytes=%s\ndevice_bytes=%s\nestimated_required_bytes=%s\n' "$source_mount" "$avail" "$image_bytes" "$required" > "$NOTES_DIR/storage-check-$RUN_ID.txt"
}

check_not_mounted() {
  local mounts
  mounts="$(lsblk -nrpo MOUNTPOINT "$DEV" | sed '/^$/d' || true)"
  [[ -z "$mounts" ]] || die "USB has mounted filesystems. Unmount only this USB after review: $mounts"
}

ensure_host_dependencies() {
  local missing=()
  command -v parted >/dev/null || missing+=(parted)
  command -v mkfs.vfat >/dev/null || missing+=(dosfstools)
  command -v partprobe >/dev/null || missing+=(parted)
  command -v mount >/dev/null || missing+=(util-linux)
  command -v udevadm >/dev/null || missing+=(udev)
  if (("${#missing[@]}" > 0)); then
    local packages
    packages="$(printf '%s\n' "${missing[@]}" | sort -u | paste -sd ' ' -)"
    log "Missing host packages required for partitioning: $packages"
    need_confirmation "Install missing host packages through apt before proceeding?" "INSTALL-HOST-DEPS"
    capture S00_INSTALL_HOST_DEPENDENCIES sudo bash -Eeuo pipefail -c "apt-get update && apt-get install -y $packages"
  fi
  command -v parted >/dev/null || die "parted remains unavailable."
  command -v mkfs.vfat >/dev/null || die "mkfs.vfat remains unavailable."
  command -v partprobe >/dev/null || die "partprobe remains unavailable."
}

ensure_tools() {
  if ! sudo docker info >/dev/null 2>&1; then
    log "Docker daemon is unavailable. Starting it may also start other containers with restart policies."
    need_confirmation "Allow systemd to start Docker for this workflow?" "START-DOCKER"
    sudo systemctl start docker
    sudo docker info >/dev/null || die "Docker daemon did not become available."
  fi
  if ! sudo docker image inspect "$TOOLS_IMAGE" >/dev/null 2>&1; then
    sudo docker build -t "$TOOLS_IMAGE" -f "$PWD/Dockerfile" "$PWD"
  fi
  sudo docker image inspect "$TOOLS_IMAGE" >/dev/null || die "Tools image build did not produce the expected image."
}

tool_run() {
  sudo docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m \
    -v "$CASE_DIR:/case:rw" "$TOOLS_IMAGE" /bin/bash "$@"
}

acquire_image() {
  local name="$1" output="$IMAGE_DIR/$1.img" dc_log="$LOG_DIR/$1.dc3dd.log"
  [[ ! -e "$output" && ! -e "$dc_log" && ! -e "$HASH_DIR/$1.sha256" ]] || die "Refusing to overwrite prior evidence for $name."
  check_not_mounted
  capture "SET_RO_$name" sudo blockdev --setro "$DEV"
  [[ "$(sudo blockdev --getro "$DEV")" == "1" ]] || die "Could not set source read-only."
  log "Acquiring $name. Execution is synchronous; next stage waits until dc3dd exits."
  capture "ACQUIRE_$name" sudo docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m \
    --device="$DEV:/dev/evidence:r" \
    -v "$IMAGE_DIR:/evidence/images:rw" -v "$LOG_DIR:/evidence/logs:rw" \
    "$TOOLS_IMAGE" dc3dd if=/dev/evidence hof="/evidence/images/$name.img" hash=sha256 rec=off log="/evidence/logs/$name.dc3dd.log"
  [[ -s "$output" ]] || die "Acquisition returned but image is missing/empty: $output"
  [[ -s "$dc_log" ]] || die "dc3dd log is missing: $dc_log"
  capture "HASH_$name" bash -Eeuo pipefail -c 'sha256sum "$1" | tee "$2"' _ "$output" "$HASH_DIR/$name.sha256"
  capture "VERIFY_HASH_$name" sha256sum -c "$HASH_DIR/$name.sha256"
  capture "HASH_LOG_$name" bash -Eeuo pipefail -c 'sha256sum "$1" | tee "$2"' _ "$dc_log" "$HASH_DIR/$name.dc3dd.log.sha256"
  printf '%s\n' "$name" >> "$NOTES_DIR/acquisition-order.txt"
  "$TERM_SHOT" --raw-read "$dc_log" --filename "$SHOT_DIR/$name-acquisition-log.png" --columns 120 || log "Could not screenshot dc3dd log."
}

verify_image_pair() {
  local first="$1" second="$2"
  capture "CMP_$first" cmp -s "$IMAGE_DIR/$first.img" "$IMAGE_DIR/$second.img"
  [[ -s "$IMAGE_DIR/$first.img" && -s "$IMAGE_DIR/$second.img" ]] || die "Comparison images are missing."
  local first_hash second_hash
  first_hash="$(sha256sum "$IMAGE_DIR/$first.img" | awk '{print $1}')"
  second_hash="$(sha256sum "$IMAGE_DIR/$second.img" | awk '{print $1}')"
  [[ "$first_hash" == "$second_hash" ]] || die "cmp and SHA-256 results disagree."
  {
    printf 'Result: IDENTICAL\n%s %s.img\n%s %s.img\n' "$first_hash" "$first" "$second_hash" "$second"
  } > "$ANALYSIS_DIR/$first-vs-$second.txt"
  "$TERM_SHOT" --raw-read "$ANALYSIS_DIR/$first-vs-$second.txt" --filename "$SHOT_DIR/$first-vs-$second.png" --columns 120 || true
}

wipe_device() {
  check_not_mounted
  local serial
  serial="$(sudo udevadm info --query=property --name="$DEV" | sed -n 's/^ID_SERIAL_SHORT=//p' | head -n1)"
  [[ "$serial" == "$EXPECTED_SERIAL" ]] || die "Serial changed before wipe."
  for name in 01_initial 02_after_deletion 03_pre_wipe_repeat; do
    [[ -s "$IMAGE_DIR/$name.img" && -s "$HASH_DIR/$name.sha256" ]] || die "Missing pre-wipe image or hash: $name"
    capture "VERIFY_PREWIPE_$name" sha256sum -c "$HASH_DIR/$name.sha256"
  done
  capture S19_ENABLE_WRITES_FOR_WIPE sudo blockdev --setrw "$DEV"
  [[ "$(sudo blockdev --getro "$DEV")" == "0" ]] || die "Device is not writable; refusing wipe."
  need_confirmation "Final destructive action: zero all logical sectors on $DEV (serial $serial)." "WIPE-$EXPECTED_SERIAL"
  capture S20_WIPE_OPERATION sudo docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m \
    --device="$DEV:/dev/evidence:rw" -v "$LOG_DIR:/evidence/logs:rw" \
    "$TOOLS_IMAGE" dc3dd wipe=/dev/evidence hash=sha256 log=/evidence/logs/04_wipe_operation.log
  [[ -s "$LOG_DIR/04_wipe_operation.log" ]] || die "Wipe log is missing; do not claim success."
  sha256sum "$LOG_DIR/04_wipe_operation.log" > "$HASH_DIR/04_wipe_operation.log.sha256"
  capture S21_SYNC_AFTER_WIPE sudo sync
  capture S22_SET_READ_ONLY_AFTER_WIPE sudo blockdev --setro "$DEV"
  [[ "$(sudo blockdev --getro "$DEV")" == "1" ]] || die "Failed to restore read-only state after wipe."
}

zero_verify() {
  local file="$IMAGE_DIR/04_after_wipe.img" size
  [[ -s "$file" ]] || die "Post-wipe image missing or empty."
  size="$(stat -c%s "$file")"
  capture S30_ZERO_IMAGE_COMPARE cmp -n "$size" "$file" /dev/zero
  printf 'PASS: all %s logical image bytes are zero; no claim is made about hidden flash translation-layer cells.\n' "$size" > "$ANALYSIS_DIR/zero_image_verification.status"
  "$TERM_SHOT" --raw-read "$ANALYSIS_DIR/zero_image_verification.status" --filename "$SHOT_DIR/zero-image-verification.png" --columns 120 || true
}

write_report() {
  local report="$REPORT_DIR/FINAL_REPORT_TEMPLATE.md"
  {
    printf '# USB Forensic Acquisition Report\n\n'
    printf -- '- Case ID: %s\n- Host: %s\n- Workflow version: %s\n- Start UTC: %s\n- End UTC: %s\n- Device: %s\n- Expected serial: %s\n\n' "$EVIDENCE_ID" "$(hostname)" "$APP_VERSION" "$START_UTC" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$DEV" "$EXPECTED_SERIAL"
    printf '## Images and SHA-256\n\n'
    for name in 01_initial 02_after_deletion 03_pre_wipe_repeat 04_after_wipe; do
      if [[ -s "$IMAGE_DIR/$name.img" ]]; then
        printf -- '- %s (%s bytes): ' "$name" "$(stat -c%s "$IMAGE_DIR/$name.img")"
        awk '{print $1}' "$HASH_DIR/$name.sha256"
      else
        printf -- '- %s: NOT CREATED\n' "$name"
      fi
    done
    printf '\n## Validation\n\n'
    printf 'Review original acquisition logs, image-pair comparison, and zero verification. This summary does not infer success for missing artifacts.\n'
  } > "$report"
  sha256sum "$report" > "$HASH_DIR/FINAL_REPORT_TEMPLATE.md.sha256"
  "$TERM_SHOT" --raw-read "$report" --filename "$SHOT_DIR/final-report-summary.png" --columns 120 || true
}

main() {
  [[ -f "$PWD/Dockerfile" && -f "$PWD/docker-compose.yml" ]] || die "Run from repository root; Dockerfile and docker-compose.yml must exist."
  capture S00_HOST_AND_STORAGE bash -c 'date -u --iso-8601=seconds; hostname; uname -a; lsblk -e7 -o NAME,PATH,TYPE,SIZE,MODEL,SERIAL,TRAN,FSTYPE,LABEL,MOUNTPOINTS; df -hT /srv/cs2ssd'
  capture S00_HOST_DEPENDENCIES ensure_host_dependencies
  discover_device
  capture S01_DEVICE_IDENTITY bash -c 'udevadm info --query=property --name="$1"; lsblk -o NAME,PATH,TYPE,SIZE,MODEL,SERIAL,TRAN,FSTYPE,LABEL,MOUNTPOINTS "$1"' _ "$DEV"
  capture S01_STORAGE_CAPACITY check_storage
  check_not_mounted
  capture S02_TOOLS_BUILD ensure_tools
  capture S03_TOOL_VERSIONS tool_run -lc 'dc3dd --version; mmls -V 2>&1 || true; fls -V 2>&1 || true; sha256sum --version | head -n1'

  need_confirmation "This workflow will destroy the existing Windows installer and reinitialize the specified USB. Confirm the serial after reviewing S01." "ERASE-AND-REINITIALIZE-$EXPECTED_SERIAL"
  # Protect against system-disk aliases even if device enumeration changes during the run.
  [[ "$(readlink -f "$DEV")" == "$(readlink -f "/dev/disk/by-id/usb-Generic_Flash_Disk_${EXPECTED_SERIAL}-0:0")" ]] || die "USB identity changed immediately before reinitialization."
  sudo blockdev --setrw "$DEV"
  [[ "$(sudo blockdev --getro "$DEV")" == "0" ]] || die "Cannot enable writes for USB reinitialization."
  check_not_mounted
  capture S04_WIPEFS sudo wipefs --all "$DEV"
  capture S05_CREATE_PARTITION_TABLE sudo parted --script "$DEV" mklabel msdos
  capture S06_CREATE_PARTITION sudo parted --script "$DEV" mkpart primary fat32 1MiB 100%
  capture S07_REREAD_PARTITIONS sudo partprobe "$DEV"
  capture S08_SETTLE_UDEV sudo udevadm settle
  PART="$(lsblk -nrpo NAME,TYPE "$DEV" | awk '$2=="part"{print $1;exit}')"
  [[ -n "$PART" && -b "$PART" ]] || die "Prepared partition was not detected."
  capture S09_CREATE_FILESYSTEM sudo mkfs.vfat -F 32 -n FORENSICLAB "$PART"
  capture S10_PREPARED_TEST_MEDIA lsblk -o NAME,PATH,TYPE,SIZE,MODEL,SERIAL,TRAN,FSTYPE,LABEL,MOUNTPOINTS "$DEV"

  local mount_dir="$RUN_DIR/usb-mount"
  mkdir -p "$mount_dir"
  capture S09_CREATE_SYNTHETIC_FILES bash -Eeuo pipefail -c '
    part="$1"; mount_dir="$2"; manifest="$3"
    mount "$part" "$mount_dir"
    printf "Synthetic forensic test file 1\\n" > "$mount_dir/sample-01.txt"
    printf "Synthetic forensic test file 2\\n" > "$mount_dir/sample-02.txt"
    dd if=/dev/urandom of="$mount_dir/sample-03.bin" bs=4096 count=4 status=none
    sha256sum "$mount_dir/sample-01.txt" "$mount_dir/sample-02.txt" "$mount_dir/sample-03.bin" > "$manifest"
    sync
    umount "$mount_dir"
  ' _ "$PART" "$mount_dir" "$NOTES_DIR/synthetic-files-before-deletion.sha256"

  acquire_image "01_initial"
  capture S10_ENABLE_WRITES sudo blockdev --setrw "$DEV"
  [[ "$(sudo blockdev --getro "$DEV")" == "0" ]] || die "Could not re-enable writes before deletion."
  PART="$(lsblk -nrpo NAME,TYPE "$DEV" | awk '$2=="part"{print $1;exit}')"
  [[ -n "$PART" && -b "$PART" ]] || die "USB partition disappeared before deletion."
  ACTIVE_MOUNT="$mount_dir"
  capture S11_DELETE_SYNTHETIC_FILES sudo bash -Eeuo pipefail -c '
    part="$1"; mount_dir="$2"
    mount "$part" "$mount_dir"
    trap '\''sync; umount "$mount_dir" >/dev/null 2>&1 || true'\'' EXIT
    rm -- "$mount_dir/sample-01.txt" "$mount_dir/sample-02.txt"
    sync
    umount "$mount_dir"
    trap - EXIT
  ' _ "$PART" "$mount_dir"
  ACTIVE_MOUNT=""
  capture S12_REENABLE_READ_ONLY sudo blockdev --setro "$DEV"
  [[ "$(sudo blockdev --getro "$DEV")" == "1" ]] || die "USB could not be set read-only after deletion."
  acquire_image "02_after_deletion"
  acquire_image "03_pre_wipe_repeat"
  verify_image_pair "02_after_deletion" "03_pre_wipe_repeat"
  wipe_device
  acquire_image "04_after_wipe"
  zero_verify

  capture S13_ANALYZE_INITIAL_PARTITIONS tool_run -lc 'mmls /case/images/01_initial.img'
  capture S14_ANALYZE_POST_DELETION_PARTITIONS tool_run -lc 'mmls /case/images/02_after_deletion.img'
  capture S15_ANALYZE_DELETED_ENTRIES tool_run -lc 'fls -r -d /case/images/02_after_deletion.img'
  capture S90_FINAL_IMAGE_HASHES sha256sum "$IMAGE_DIR/01_initial.img" "$IMAGE_DIR/02_after_deletion.img" "$IMAGE_DIR/03_pre_wipe_repeat.img" "$IMAGE_DIR/04_after_wipe.img"
  write_report
  capture S99_FINAL_INVENTORY find "$CASE_DIR" -maxdepth 4 -type f -printf '%p (%s bytes)\n'
  log "Workflow finished without detected command failures. Review all logs and manifests before interpreting results."
}
main "$@"
